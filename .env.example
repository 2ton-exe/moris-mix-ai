# Public values for the Vite frontend.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Edge Function settings. Keep secrets server-side.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
AI_PROVIDER=gemini
# Pin the exact model, not a "-latest" alias, so evaluation runs are reproducible.
# 3.5 Flash-Lite is the stable free-tier baseline (3.6 Flash returns 503 too often).
AI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=your_gemini_api_key_here
AI_DAILY_LIMIT=20

# AI endpoints are OFF by default. Local development and demo environments set
# the opt-ins below; production stays off until BE-12 provides atomic quota
# accounting (see docs/api/ai-integration.md).
# AI_EXTRACT_ENABLED=true
# AI_GENERATE_ENABLED=true
# Optional hard stops; truthy overrides the matching opt-in. Safe in production.
# AI_EXTRACT_DISABLED=1
# AI_GENERATE_DISABLED=1
# Failure drills are demo-only and only fire when AI_ENVIRONMENT is development
# or test. Never set the environment value or the drill switches in production.
# AI_ENVIRONMENT=development
# AI_ALLOW_FAILURE_DRILLS=1
# AI_SIMULATE_OUTAGE=1
# AI_SIMULATE_BAD_OUTPUT=1

# Main database and migration settings. Never expose to client/frontend.
# Use port 5432 for session pooling/direct connection, or port 6543 for transaction pooling:
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
RLS_EXPECTED_PROJECT_REF="your-main-project-ref"
SUPABASE_SECRET_KEY="your-supabase-secret-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Optional dedicated non-production Supabase test project for live non-production test database RLS integration testing (never use production).
# RUN_NON_PRODUCTION_TEST_DATABASE_RLS_INTEGRATION="false"
# NON_PRODUCTION_TEST_DATABASE_SUPABASE_URL="https://your-dedicated-test-project.supabase.co"
# NON_PRODUCTION_TEST_DATABASE_SUPABASE_ANON_KEY="your-dedicated-test-anon-key"
# NON_PRODUCTION_TEST_DATABASE_SUPABASE_SERVICE_ROLE_KEY="your-dedicated-test-service-role-key"
# NON_PRODUCTION_TEST_DATABASE_EXPECTED_PROJECT_REF="your-dedicated-test-project-ref"
# NON_PRODUCTION_TEST_DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
