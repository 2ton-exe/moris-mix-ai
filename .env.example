# Public values for the Vite frontend. Replace these placeholders with your Supabase project values.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side values for Supabase Edge Functions. Never expose these to the browser.
GEMINI_API_KEY=your-gemini-api-key
AI_MODEL=your-gemini-model
AI_PROVIDER=gemini
